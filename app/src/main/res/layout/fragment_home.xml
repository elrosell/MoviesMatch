<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true"
    android:padding="16dp"
    tools:context=".interfaz.inicio.InicioFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/btnMenuOpciones"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end"
            android:background="@android:color/transparent"
            android:contentDescription="@string/menu_opciones"
            android:padding="4dp"
            app:srcCompat="@drawable/ic_menu" />

        <com.example.moviematch.interfaz.comun.TextoDegradadoView
            android:id="@+id/txtHomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/home_titulo"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtHomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/home_subtitulo"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/home_tiempo"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            app:chipSpacing="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime30"
                style="@style/AppChip.Dark"
                android:text="@string/opcion_tiempo_30" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime60"
                style="@style/AppChip.Dark"
                android:text="@string/opcion_tiempo_60" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime90"
                style="@style/AppChip.Dark"
                android:text="@string/opcion_tiempo_90" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime120"
                style="@style/AppChip.Dark"
                android:text="@string/opcion_tiempo_120" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/home_estado_animo"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            app:chipSpacing="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoodRelax"
                style="@style/AppChip.Dark"
                android:text="@string/opcion_mood_relax"
                android:tag="Relax" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoodRisa"
                style="@style/AppChip.Dark"
                android:text="@string/opcion_mood_risa"
                android:tag="Risa" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoodPensar"
                style="@style/AppChip.Dark"
                android:text="@string/opcion_mood_pensar"
                android:tag="Pensar" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoodSusto"
                style="@style/AppChip.Dark"
                android:text="@string/opcion_mood_susto"
                android:tag="Susto" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="@string/home_compania"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            app:chipSpacing="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSolo"
                style="@style/AppChip.Dark"
                android:text="@string/opcion_compania_solo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPareja"
                style="@style/AppChip.Dark"
                android:text="@string/opcion_compania_pareja" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAmigos"
                style="@style/AppChip.Dark"
                android:text="@string/opcion_compania_amigos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFamilia"
                style="@style/AppChip.Dark"
                android:text="@string/opcion_compania_familia" />

        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuscarPelicula"
            style="@style/AppButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/boton_buscar"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModoGrupo"
            style="@style/AppButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/boton_modo_grupo"
            android:textAllCaps="false"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
