<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:fillViewport="true"
    android:padding="16dp"
    tools:context=".ui.inicio.InicioFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <com.example.moviematch.ui.common.GradientTextView
            android:id="@+id/txtHomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="¿Qué vemos hoy?"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtHomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="Elige tu tiempo, mood y compañía y yo hago la magia."
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="• Tiempo disponible"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            app:chipSpacing="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime30"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="30 min" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime60"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="1 h" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime90"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="1.5 h" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTime120"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="2 h+" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="• Estado de ánimo"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupMood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            app:chipSpacing="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoodRelax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="😴 Relax" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoodRisa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="😂 Risa" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoodPensar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="🧠 Pensar" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMoodSusto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="😱 Susto" />

        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:text="• ¿Con quién estás?"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCompany"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            app:chipSpacing="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSolo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="Solo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPareja"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="Pareja" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAmigos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="Amigos" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFamilia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/AppChip.Dark"
                android:text="Familia" />

        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBuscarPelicula"
            style="@style/AppButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Buscar película"
            android:textAllCaps="false"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnModoGrupo"
            style="@style/AppButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Modo grupo"
            android:textAllCaps="false"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
