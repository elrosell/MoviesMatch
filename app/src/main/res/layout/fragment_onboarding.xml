<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollOnboarding"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030213"
    android:padding="16dp"
    tools:context=".interfaz.configuracion.ConfiguracionInicialFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- “Hero” superior -->
        <TextView
            android:id="@+id/txtWelcomeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_titulo"
            android:textColor="@android:color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtWelcomeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_subtitulo"
            android:textColor="#9CA3AF"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <!-- Géneros -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_generos"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupGenres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="false"
            app:chipSpacing="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAccion"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/genero_accion" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipComedia"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/genero_comedia" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDrama"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/genero_drama" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTerror"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/genero_terror" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSciFi"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/genero_scifi" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRomance"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/genero_romance" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Plataformas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_plataformas"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPlatforms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="false"
            app:chipSpacing="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipNetflix"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/plataforma_netflix" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPrime"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/plataforma_prime" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDisney"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/plataforma_disney" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHbo"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/plataforma_hbo" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipApple"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/plataforma_apple" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Cosas a evitar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_evitar"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupAvoid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="false"
            app:chipSpacing="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipViolencia"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/evitar_violencia" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGore"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/evitar_gore" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipLentas"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/evitar_lentas" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFinalTriste"
                style="@style/Widget.MaterialComponents.Chip.Filter"
                android:text="@string/evitar_final_triste" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="32dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkipOnboarding"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:text="@string/boton_saltar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFinishOnboarding"
                style="@style/Widget.MaterialComponents.Button"
                android:text="@string/boton_continuar"
                android:layout_marginStart="8dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
