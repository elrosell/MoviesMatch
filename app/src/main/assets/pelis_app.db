CREATE TABLE watchlist (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    pelicula_id TEXT UNIQUE NOT NULL,
    titulo TEXT,
    anio INTEGER,
    duracion_min INTEGER,
    generos TEXT,
    plataformas TEXT,
    mood TEXT,
    sinopsis TEXT,
    poster_url TEXT,
    fecha_guardado INTEGER
);

CREATE TABLE descartadas (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    pelicula_id TEXT UNIQUE NOT NULL,
    fecha_descartado INTEGER
);
